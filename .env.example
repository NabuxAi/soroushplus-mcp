# Writes stay off until this is 1.
NABU_MESSAGING_ENABLE_SEND=0

# Bot mode (official bot API)
SOROUSHPLUS_BOT_TOKEN=
# Chats the bot may write to, comma-separated. Empty = none; "*" = any.
SOROUSHPLUS_ALLOWED_CHAT_IDS=

# Web mode (your own account through Soroush Plus Web, in a local Chrome window)
NABU_BROWSER_ENABLE=0
# Chats web mode may write to as you. "me" = your saved messages; @username or ids; "*" = any.
SOROUSHPLUS_WEB_ALLOWED_CHATS=
# Create/join/leave chats, members, admins. Off unless 1.
NABU_WEB_ALLOW_ACCOUNT_CHANGES=0
# When this machine has no Iranian IP, e.g. after: ssh -N -D 127.0.0.1:1088 <server-in-iran>
NABU_BROWSER_PROXY=
# Installed Chrome by default; set CHROME_EXECUTABLE_PATH to use another Chromium.
NABU_BROWSER_CHANNEL=chrome
CHROME_EXECUTABLE_PATH=
NABU_BROWSER_HEADLESS=0

# Files: local files are read only from here; downloads go to <root>/downloads/soroushplus/.
NABU_MESSAGING_FILE_ROOT=
